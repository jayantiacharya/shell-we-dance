# Dockerfile - Containerizes the dashboard server
# CS 3030 - Project 7: Final Capstone
# Owner: Omar
#
# Purpose:
#   Build a small and secure container for the Infrastructure Health Dashboard.
#   The first stage validates the Python dashboard code. The final runtime
#   stage contains only what is required to run the dashboard.
#
# The dashboard reads health.json from /data/health.json. Docker Compose will
# mount the latest report generated by the Bash/Python pipeline at that path.

# ---------------------------------------------------------------------------
# Stage 1 - Builder / validation
# ---------------------------------------------------------------------------

FROM python:3.12-slim AS builder

WORKDIR /build

# Copy the dashboard source into the temporary build stage.
COPY src/dashboard_server.py /build/dashboard_server.py

# Verify Python syntax while the image is being built.
# A syntax error will cause docker build to fail immediately.
RUN python -m py_compile /build/dashboard_server.py


# ---------------------------------------------------------------------------
# Stage 2 - Final runtime image
# ---------------------------------------------------------------------------

FROM python:3.12-slim AS runtime

WORKDIR /app

# Create a dedicated non-root account.
# The dashboard does not need root permissions to serve HTTP on port 8000.
RUN groupadd --system dashboard && \
    useradd --system \
        --gid dashboard \
        --home-dir /app \
        --shell /usr/sbin/nologin \
        dashboard

# Copy only the validated application file from the builder stage.
COPY --from=builder /build/dashboard_server.py /app/dashboard_server.py

# Give the non-root dashboard user ownership of the application directory.
RUN chown -R dashboard:dashboard /app

# Document the port used by dashboard_server.py.
EXPOSE 8000

# Run the web server as the non-root account created above.
USER dashboard

# Docker periodically checks the HTTP endpoint.
# If the dashboard stops responding, Docker marks the container unhealthy.
HEALTHCHECK --interval=30s \
    --timeout=5s \
    --start-period=5s \
    --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/', timeout=3)" || exit 1

# Start the dashboard and read the health report mounted by Docker Compose.
CMD ["python", "dashboard_server.py", "--host", "0.0.0.0", "--port", "8000", "--file", "/data/health.json"]
